# Enforce LF line endings across Linux and Windows
* text=auto eol=lf

# Godot & data text files
*.gd text eol=lf
*.tscn text eol=lf
*.tres text eol=lf
*.gdshader text eol=lf
*.json text eol=lf
*.md text eol=lf
*.cfg text eol=lf
*.import text eol=lf
*.uid text eol=lf
*.godot text eol=lf
*.svg text eol=lf
*.txt text eol=lf
*.sh text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
.editorconfig text eol=lf

# Binary assets
*.ttf binary
*.otf binary
*.png binary
*.jpg binary
*.webp binary
*.ogg binary
*.wav binary
*.mp3 binary
*.zip binary
